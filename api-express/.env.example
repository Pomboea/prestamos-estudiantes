PORT=3000
# Opción A: variables sueltas
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prestamos
DB_PASSWORD=prestamos
DB_NAME=prestamos_aux
# Opción B: URL completa (Railway la entrega como MYSQL_URL)
# MYSQL_URL=mysql://usuario:clave@host:puerto/base
# DB_SSL=true   # Aiven / proveedores que exigen SSL
# Debe ser IGUAL a la SECRET_KEY de la API FastAPI para aceptar sus tokens
SECRET_KEY=cambie-esta-clave-secreta-larga-y-aleatoria
CORS_ORIGINS=*
